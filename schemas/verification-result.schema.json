{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-result.schema.json",
  "title": "GroundSpec Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plan", "implementation", "passed", "commands", "recordedAt"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "plan": { "$ref": "#/$defs/reference" },
    "implementation": { "$ref": "#/$defs/reference" },
    "passed": { "type": "boolean" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "argv", "workingDirectory", "exitCode", "passed", "optional", "log"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "workingDirectory": { "type": "string", "minLength": 1 }, "exitCode": { "type": "integer" }, "passed": { "type": "boolean" },
          "optional": { "type": "boolean" }, "log": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "reference": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string" }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
