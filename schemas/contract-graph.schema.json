{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-graph.schema.json",
  "title": "GroundSpec Contract Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inputs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "proof": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
