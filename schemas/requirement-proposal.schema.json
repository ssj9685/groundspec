{
  "title": "GroundSpec Requirement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceBundle", "producer", "requirements", "questions"],
  "properties": {
    "version": { "const": 1 },
    "sourceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "classification", "sourceBlocks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["explicit", "inferred", "assumption"] },
          "sourceBlocks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^B-[a-f0-9]{12}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sourceBlocks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "sourceBlocks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^B-[a-f0-9]{12}$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
