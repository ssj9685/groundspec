{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-ledger.schema.json",
  "title": "GroundSpec Requirement Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceBundle", "requirements", "unresolved"],
  "properties": {
    "version": { "const": 1 },
    "sourceBundle": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "classification", "status", "sourceBlocks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["explicit", "inferred", "assumption"] },
          "status": { "enum": ["accepted", "rejected", "proposed"] },
          "sourceBlocks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^B-[a-f0-9]{12}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sourceBlocks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "sourceBlocks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^B-[a-f0-9]{12}$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
